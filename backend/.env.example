# Copy to .env: every variable is optional. Without a database or Redis the
# API reads live data from OpenF1, FastF1 and Jolpica and caches it in memory.

# PostgreSQL, where ingested sessions are stored
DATABASE_URL=
# Redis, for the shared cache
REDIS_URL=
# An OpenF1 account, needed to read a session while it is live
OPENF1_EMAIL=
OPENF1_PASSWORD=
# Protects the ingestion routes (/api/admin), sent as the X-Admin-Secret header
ADMIN_SECRET=
